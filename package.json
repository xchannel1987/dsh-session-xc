{
  "name": "dsh-session-xc",
  "version": "0.7.4",
  "description": "DSH web plugin: 工作区可见会话数 + 已完成未读会话数 + 已归档会话入口与恢复/删除 + 批量删除已归档会话 + 跨工作区移动会话（配置：\"会话增强\"设置卡片）。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keyiadiannao/dsh-session-xc.git"
  },
  "bugs": {
    "url": "https://github.com/keyiadiannao/dsh-session-xc/issues"
  },
  "homepage": "https://github.com/keyiadiannao/dsh-session-xc#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "workspace"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "esbuild src/index.js --bundle --platform=node --format=esm --outfile=lib/index.js",
    "build:client": "esbuild src/client.js --bundle --platform=browser --format=iife --outfile=lib/client.js --external:react",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}